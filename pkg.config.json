{
  "name": "wisdom-stream",
  "pkg": {
    "targets": [
      "node22-win-x64"
    ],
    "assets": [
      "src/views/**/*",
      "public/css/**/*",
      "public/js/**/*",
      "node_modules/video.js/dist/video.min.js",
      "node_modules/video.js/dist/video-js.min.css",
      "node_modules/video.js/dist/font/**/*",
      "node_modules/bootstrap/dist/css/bootstrap.min.css"
    ],
    "outputPath": "dist"
  }
}