<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wisdom Stream</title>
    <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/app.css">
</head>

<body>
    <nav class="navbar navbar-dark ws-nav">
        <a class="navbar-brand font-weight-bold" href="/">Wisdom Stream</a>
        <span class="navbar-text small">Watch together. In sync.</span>
    </nav>

    <div class="container py-4">
        <div class="row">
            <div class="col-md-6 mb-3">
                <div class="card ws-card h-100">
                    <div class="card-body">
                        <h5 class="card-title">Play any video link</h5>
                        <p class="card-text small text-muted-light">Paste a direct <code>.mp4</code> or <code>.m3u8</code> (HLS) link.</p>
                        <form action="/watch" method="get" class="d-flex">
                            <input type="url" name="url" class="form-control mr-2" placeholder="https://example.com/movie.m3u8" required>
                            <button class="btn btn-primary">Play</button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <div class="card ws-card h-100">
                    <div class="card-body">
                        <h5 class="card-title">Join a watch party</h5>
                        <p class="card-text small text-muted-light">Paste the room link or room code your friend shared.</p>
                        <form id="joinForm" class="d-flex">
                            <input type="text" id="joinInput" class="form-control mr-2" placeholder="wisdom_1a2b3c4d" required>
                            <button class="btn btn-success">Join</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center mt-3 mb-3">
            <h4 class="mb-2">Movies</h4>
            <input type="search" id="searchInput" class="form-control ws-search mb-2" placeholder="Search movies..." value="<%= q %>">
        </div>

        <div class="row" id="movieGrid">
            <% videos.forEach(video => { %>
                <div class="col-sm-6 col-lg-4 mb-4 movie-item" data-title="<%= video.title.toLowerCase() %>">
                    <a class="card ws-card movie-card h-100" href="/watch?v=<%= encodeURIComponent(video.id) %>">
                        <% if (video.thumb) { %>
                            <img class="card-img-top movie-thumb" src="<%= video.thumb %>" alt="<%= video.title %>" loading="lazy"
                                onerror="this.replaceWith(Object.assign(document.createElement('div'), {className: 'movie-thumb placeholder-thumb', textContent: '\u25B6'}))">
                        <% } else { %>
                            <div class="movie-thumb placeholder-thumb">&#9654;</div>
                        <% } %>
                        <div class="card-body">
                            <h6 class="card-title mb-1"><%= video.title %></h6>
                            <p class="card-text small text-muted-light mb-0"><%= video.description %></p>
                        </div>
                    </a>
                </div>
            <% }); %>
        </div>
        <p id="noResults" class="text-muted-light" style="display: none;">No movies match your search.</p>

        <p class="small text-muted-light mt-4">
            Movies are Blender Foundation open movies (Creative Commons). Drop your own <code>.mp4</code> files into
            <code>public/videos/</code> and they show up here automatically.
        </p>
    </div>

    <script>
        const searchInput = document.getElementById('searchInput');
        const filterMovies = () => {
            const query = searchInput.value.trim().toLowerCase();
            let shown = 0;
            document.querySelectorAll('.movie-item').forEach(item => {
                const match = item.dataset.title.includes(query);
                item.style.display = match ? '' : 'none';
                if (match) shown++;
            });
            document.getElementById('noResults').style.display = shown ? 'none' : '';
        };
        searchInput.addEventListener('input', filterMovies);
        filterMovies();

        document.getElementById('joinForm').addEventListener('submit', (event) => {
            event.preventDefault();
            const value = document.getElementById('joinInput').value.trim();
            let room = value;
            try {
                room = new URL(value).searchParams.get('room') || value;
            } catch { /* plain room code */ }
            location.href = '/watch?room=' + encodeURIComponent(room);
        });
    </script>
</body>

</html>
